<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d64018fa-ec43-4d57-b4a2-afd4336ba7ce">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Cross-Curriculum Priority</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AA</statementNotation>
	<dcterms:description xml:lang="en-au">&lt;p&gt;The Asia region exerts significant influence globally and in Australia. Young Australians need to develop the knowledge, skills, capabilities and attitudes to effectively navigate and contribute to our regional neighbourhood.&lt;/p&gt;&lt;p&gt;Asia is our part of the world. Knowing, understanding and growing engagement with Asia are foundational for young people as Australia seeks to strengthen its ties in the Asia region.&lt;/p&gt;</dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">Asia and Australia's Engagement with Asia</dcterms:title>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/b7e0b1cf-96f9-4710-9928-edd1540d037b"/>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/665d9a7a-3b10-4f3a-a480-010ce6e1d22b"/>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/13b74d1d-00bf-455b-bd58-3771a287c550"/>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/5c04d332-8412-4e26-bd57-425883be63aa"/>
	<skos:prefLabel xml:lang="en-au">AA</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/b7e0b1cf-96f9-4710-9928-edd1540d037b">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<listID xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">1</listID>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Set of organising ideas</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAK</statementNotation>
	<dcterms:description xml:lang="en-au">These organising ideas emphasise the need to appreciate the backgrounds, experiences, stories, religions, beliefs and perspectives within and among the nations of the Asia region and the interconnections with Australia. </dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">Knowing Asia and its diversity</dcterms:title>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/0a8ee105-c28c-46ea-bd8d-f6e70a730aa8"/>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/443c9e36-19f6-408b-a984-99c0ff18fda9"/>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d64018fa-ec43-4d57-b4a2-afd4336ba7ce"/>
	<skos:prefLabel xml:lang="en-au">AAK</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/0a8ee105-c28c-46ea-bd8d-f6e70a730aa8">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAK1</statementNotation>
	<dcterms:description xml:lang="en-au">People of the Asia region are diverse in backgrounds, experiences, stories, religions, beliefs and perspectives.</dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">People of the Asia region are diverse in backgrounds, experiences, stories, religions, beliefs and perspectives.</dcterms:title>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/b7e0b1cf-96f9-4710-9928-edd1540d037b"/>
	<skos:prefLabel xml:lang="en-au">AAK1</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/443c9e36-19f6-408b-a984-99c0ff18fda9">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAK2</statementNotation>
	<dcterms:description xml:lang="en-au">The interrelationships between people and the diverse environments and systems across the Asia region have global implications. </dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">The interrelationships between people and the diverse environments and systems across the Asia region have global implications. </dcterms:title>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/b7e0b1cf-96f9-4710-9928-edd1540d037b"/>
	<skos:prefLabel xml:lang="en-au">AAK2</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/665d9a7a-3b10-4f3a-a480-010ce6e1d22b">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<listID xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">2</listID>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Set of organising ideas</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAU</statementNotation>
	<dcterms:description xml:lang="en-au">These organising ideas examine the ways in which different significant nations in Asia have affected change and contributed to global developments. </dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">Understanding Asia's global significance</dcterms:title>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/66787a3c-bd1f-45f9-9aac-65ffe9bc3c5e"/>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d6b64eae-08b7-411f-9ebf-fb829d491fa4"/>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d64018fa-ec43-4d57-b4a2-afd4336ba7ce"/>
	<skos:prefLabel xml:lang="en-au">AAU</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/66787a3c-bd1f-45f9-9aac-65ffe9bc3c5e">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAU1</statementNotation>
	<dcterms:description xml:lang="en-au">The nations of Asia influence historical and contemporary global relationships, including international responses to global developments and events.</dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">The nations of Asia influence historical and contemporary global relationships, including international responses to global developments and events.</dcterms:title>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/665d9a7a-3b10-4f3a-a480-010ce6e1d22b"/>
	<skos:prefLabel xml:lang="en-au">AAU1</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d6b64eae-08b7-411f-9ebf-fb829d491fa4">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAU2</statementNotation>
	<dcterms:description xml:lang="en-au">The peoples of Asia shape human endeavour through aesthetic, creative, political, sporting, economic, technological and scientific domains.</dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">The peoples of Asia shape human endeavour through aesthetic, creative, political, sporting, economic, technological and scientific domains.</dcterms:title>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/665d9a7a-3b10-4f3a-a480-010ce6e1d22b"/>
	<skos:prefLabel xml:lang="en-au">AAU2</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/13b74d1d-00bf-455b-bd58-3771a287c550">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<listID xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">3</listID>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Set of organising ideas</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAG</statementNotation>
	<dcterms:description xml:lang="en-au">These organising ideas include the relationship-building contribution of Australians with Asian heritage and explore how active connections between young people and Asia’s diverse communities can be deepened and contribute to global citizenship. </dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">Growing Asia-Australia engagement</dcterms:title>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/c44ca798-515b-45c0-9bb3-88d95437c391"/>
	<hasChild xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/7ca01fdb-c66b-41a3-b772-46fba943966e"/>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/d64018fa-ec43-4d57-b4a2-afd4336ba7ce"/>
	<skos:prefLabel xml:lang="en-au">AAG</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/c44ca798-515b-45c0-9bb3-88d95437c391">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAG1</statementNotation>
	<dcterms:description xml:lang="en-au">Australia’s developing and deepening relationships with the peoples of Asia influence both mutual understandings and expressions of citizenship and culture nationally, regionally and globally.</dcterms:description>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-03T15:54:30.000Z</dcterms:modified>
	<dcterms:title xml:lang="en-au">Australia’s developing and deepening relationships with the peoples of Asia influence both mutual understandings and expressions of citizenship and culture nationally, regionally and globally.</dcterms:title>
	<isChildOf xmlns="http://purl.org/gem/qualifiers/" rdf:resource="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/13b74d1d-00bf-455b-bd58-3771a287c550"/>
	<skos:prefLabel xml:lang="en-au">AAG1</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocabulary.curriculum.edu.au/MRAC/2024/04/CCP/AA/7ca01fdb-c66b-41a3-b772-46fba943966e">
	<rdf:type rdf:resource="http://purl.org/ASN/schema/core/Statement"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<authorityStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNAuthorityStatus/Original"/>
	<conceptTerm xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">SCIENCE_TEACHER_BACKGROUND_INFORMATION</conceptTerm>
	<indexingStatus xmlns="http://purl.org/ASN/schema/core/" rdf:resource="http://purl.org/ASN/scheme/ASNIndexingStatus/No"/>
	<statementLabel xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">Organising Idea</statementLabel>
	<statementNotation xmlns="http://purl.org/ASN/schema/core/" xml:lang="en-au">AAG2</statementNotation>
	<dcterms:description xml:lang="en-au">Australia and Asia are interdependent through a range of historical and contemporary connections.</dcterms:description>
