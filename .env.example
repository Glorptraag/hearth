# ─────────────────────────────────────────────────────────────────────────────
# Hearth LMS — Environment Variables
# Copy to .env.local for development. Set in Vercel project settings for prod.
# Keys marked (required) will crash or silently degrade the app if missing.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database: Neon serverless Postgres ───────────────────────────────────────
# (required) Full connection string from Neon dashboard.
# Pooled URL is fine; Drizzle + @neondatabase/serverless handle pooling.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/hearth?sslmode=require

# ─── Auth: Clerk ──────────────────────────────────────────────────────────────
# (required) Keys from your Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# (required) Redirect paths. Do not change unless routing is also updated.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── CMS: Sanity ──────────────────────────────────────────────────────────────
# (required) Public project identifiers. Safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=replace_me
NEXT_PUBLIC_SANITY_DATASET=production

# (optional) Write token — only needed for seeding scripts and preview content
# writes from server code. Do NOT set in browser-exposed envs.
SANITY_API_TOKEN=

# ─── AI: Anthropic ────────────────────────────────────────────────────────────
# (required) Haiku enrichment at write-time. Used by src/lib/ai/*.
# The Anthropic SDK reads this automatically.
ANTHROPIC_API_KEY=sk-ant-replace_me

# (optional) Kill switch for the debounced in-Logger draft-insight calls.
# Set to "false" to instantly disable the live "Hearth is noticing" panel
# if cost tracking in aiPipelineLogs shows spend approaching the $3/month
# soft ceiling. Unset or "true" leaves it on. Safe to flip at any time.
DRAFT_INSIGHTS_ENABLED=true

# ─── Storage: Vercel Blob (evidence uploads) ──────────────────────────────────
# (optional) Without this, /api/evidence/upload returns 503 with a clear
# message. Photo/media evidence capture is unavailable until set.
BLOB_READ_WRITE_TOKEN=

# ─── Cron jobs (Vercel Pro required) ──────────────────────────────────────────
# (required in prod) Shared secret used to authorise scheduled calls to
# /api/admin/retention (Sun 02:00 UTC) and /api/admin/invitations/expire
# (daily 20:00 UTC). Vercel injects it as the Bearer token for cron requests.
CRON_SECRET=

# ─── Admin allowlist ──────────────────────────────────────────────────────────
# (optional) Comma-separated Clerk user IDs permitted to view /admin routes
# and run seed endpoints in production. Leave empty in dev to treat all
# signed-in users as admin.
ADMIN_CLERK_IDS=

# ─── Observability: Sentry ────────────────────────────────────────────────────
# (optional) Sentry DSN. If unset, Sentry is a no-op — safe in local dev.
# Free tier (5k errors/mo) is sufficient for alpha pilot.
# Public because Sentry DSNs are safe to expose (they're write-only).
NEXT_PUBLIC_SENTRY_DSN=

# Set these in Vercel for source-map upload on deploy (optional but recommended):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ─── Analytics: PostHog (self-hosted) ─────────────────────────────────────────
# (optional) Project key + self-hosted instance URL. If either is unset the
# analytics client no-ops. Only fires on authenticated routes. Family IDs are
# SHA-256 hashed before transit; no PII, no entry text is ever sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Payments: Stripe (STUBBED — do not set for alpha) ────────────────────────
# Stripe is intentionally disabled in v1. /api/stripe/* returns 503.
# Do not set these until Phase 3+ when payments are revived.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
