# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# claude code worktrees
.claude/worktrees/

# claude code runtime artifacts
.claude/scheduled_tasks.lock
.claude/plans/status.json
.claude/plans/*.output

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archived docs (kept locally for reference; history preserved in git log)
docs/archive/

# transient eval-harness run artifacts (committed results live in the audit .md docs)
docs/audits/_eval-dlo-run-*.json

# pre-downloaded pedagogy corpus source texts (PG/archive.org scans, not committed)
corpus/.source-cache/


# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
