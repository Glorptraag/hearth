{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "node --env-file-if-exists=.env.test.local --env-file-if-exists=.env.local scripts/neon-test-branch.mjs",
    "test:integration:only": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "docker compose -f docker-compose.test.yml up -d --wait && (export DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hearth_test && npm run db:migrate && npm run test:integration:only); status=$?; docker compose -f docker-compose.test.yml down; exit $status",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "seed:packs": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/scripts/seed-sample-packs/index.ts",
    "promote:packs": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/scripts/promote-packs/index.ts",
    "seed:pedagogy:frameworks": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-pedagogy-frameworks.ts",
    "seed:pedagogy:corpus": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/ingest-pedagogy-corpus.ts",
    "seed:pedagogy:reembed": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/reembed-pedagogy-corpus.ts",
    "verify:pkb": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-pkb-embeddings.ts",
    "verify:sanity": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-sanity-docs.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/deploy-migrate.mjs",
    "db:encrypt-notes": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/encrypt-facilitator-notes.ts",
    "db:check-drift": "node --env-file-if-exists=.env.local scripts/check-migration-drift.mjs",
    "db:check-schema": "node scripts/check-schema-vs-migrations.mjs",
    "check:route-handlers": "node scripts/check-route-handlers.mjs",
    "check:sanity-gating": "node scripts/check-sanity-gating.mjs",
    "audit:published-packs": "node --env-file-if-exists=.env.local scripts/audit-published-packs.mjs",
    "audit:content-readiness": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/scripts/audit-content-readiness/index.ts",
    "retract:packs": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs src/scripts/retract-packs/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@clerk/nextjs": "^7.0.6",
    "@neondatabase/serverless": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^6.0.3",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "^5.18.0",
    "@sentry/nextjs": "^10.49.0",
    "@vercel/blob": "^2.4.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.1",
    "next-sanity": "^12.1.6",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.369.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "styled-components": "^6.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.13.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
